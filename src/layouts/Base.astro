---
import "@fontsource/inter-tight/400.css";
import "@fontsource/inter-tight/500.css";
import { ORDER, S, wa } from "../data.js";
const { title, desc = "Fotografía, video y tecnología para personas, parejas, eventos y negocios.", seg = "", sticky = true } = Astro.props;
const cta = "/diagnostico" + (seg ? "/" + seg : "");
const msg = "Hola kodialabs, quiero info" + (seg && S[seg] ? " de " + S[seg].label.toLowerCase() : "");
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0E0705" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='40' fill='%23E8541A'/%3E%3C/svg%3E" />
</head>
<body class={sticky ? "hasst" : ""}>
  <div class="bg" aria-hidden="true">
    <div class="glow pulse" style="width:620px;height:620px;left:-220px;top:60px;opacity:.7"></div>
    <div class="glow" style="width:480px;height:480px;right:-200px;top:520px;opacity:.35"></div>
  </div>
  <div class="wrap">
    <nav>
      <a class="logo" href="/"><b></b>kodialabs</a>
      <a class="btn line" href={wa(msg)}>Escríbenos</a>
    </nav>
    <div class="seg-nav">
      {ORDER.map((k) => <a href={`/${k}`} aria-current={seg === k ? "page" : undefined}>{S[k].label}</a>)}
    </div>
  </div>
  <main><slot /></main>
  <div class="wrap"><footer class="site"><span>© 2026 kodialabs</span><a href="https://instagram.com/kodialabs">Instagram @kodialabs</a></footer></div>
  {sticky && (
    <div class="sticky"><span>¿No sabes cuál elegir?</span><a class="btn" href={cta}>Encuentra tu paquete</a></div>
  )}
</body>
</html>

<style is:global>
:root{--bg:#0E0705;--line:#35221A;--ink:#F6EFEA;--muted:#A89A92;--orange:#E8541A;--orange2:#FF8A3D;color-scheme:dark}
html{background:var(--bg);-webkit-text-size-adjust:100%}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.5 "Inter Tight","Helvetica Neue",Arial,sans-serif;overflow-x:clip;position:relative;padding-top:env(safe-area-inset-top,0px)}
.bg{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.final .glow{left:50%!important;translate:-50% 0;transform:none!important}
body.hasst{padding-bottom:calc(84px + env(safe-area-inset-bottom,0px))}
h1,h2,h3,p{margin:0}
h1,h2{font-weight:400;text-transform:uppercase;letter-spacing:-.04em;line-height:.92}
h1{font-size:clamp(3rem,11vw,8rem)}
h2{font-size:clamp(2rem,6vw,4rem)}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--orange2);outline-offset:4px}
.wrap{max-width:1160px;margin:0 auto;padding:0 22px;position:relative;z-index:1}
section{padding:72px 0;position:relative}
.glow{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:0;background:radial-gradient(circle,var(--orange) 0%,rgba(232,84,26,.5) 40%,transparent 70%)}
nav{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0 12px}
.logo{font-weight:500;font-size:1.25rem;letter-spacing:-.04em}
.logo b{display:inline-block;width:.62em;height:.62em;border-radius:50%;background:linear-gradient(135deg,var(--orange2),var(--orange));margin-right:.4em}
.seg-nav{display:flex;gap:8px;overflow-x:auto;padding:8px 0 4px;scrollbar-width:none}
.seg-nav a{padding:8px 16px;border-radius:999px;border:1px solid var(--line);color:var(--muted);white-space:nowrap;font-size:.95rem}
.seg-nav a[aria-current="page"]{background:var(--ink);color:#1A0A03;border-color:var(--ink)}
.btn{display:inline-block;padding:14px 26px;border-radius:999px;font-weight:500;text-align:center;border:0;font-family:inherit;font-size:1rem;background:linear-gradient(135deg,var(--orange2),var(--orange));color:#1A0A03;transition:filter .2s}
.btn:hover{filter:brightness(1.12)}
.btn.line{background:rgba(255,255,255,.04);color:var(--ink);border:1px solid var(--line)}
.lead{color:var(--muted);font-size:1.1rem;max-width:28em}
.cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.hero{padding:56px 0 24px}
.back{color:var(--muted);font-size:.95rem;display:inline-block;margin-bottom:28px}
.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:28px}
.tile{min-height:260px;border-radius:20px;border:1px solid var(--line);padding:24px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s,border-color .2s}
.tile:hover{transform:translateY(-4px);border-color:var(--orange)}
.tile:last-child:nth-child(odd){grid-column:1/-1}
.tile h3{font-weight:400;font-size:clamp(2rem,5vw,3.2rem);letter-spacing:-.04em;text-transform:uppercase;line-height:.95}
.tile p{color:#D9CBC2;max-width:18em;font-size:.95rem}
.tile .go{display:flex;justify-content:space-between;align-items:center;margin-top:18px;font-weight:500}
.tile .go span:last-child{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.1)}
.t0{background:radial-gradient(120% 90% at 100% 100%,#8A3A12,#1A0F0A 65%)}
.t1{background:radial-gradient(120% 90% at 0% 100%,#B8400F,#1A0F0A 65%)}
.t2{background:radial-gradient(120% 90% at 100% 0%,#9C4A22,#1A0F0A 65%)}
.t3{background:radial-gradient(120% 90% at 0% 0%,#D9601F,#1A0F0A 65%)}
.t4{background:radial-gradient(120% 90% at 50% 100%,#7A3512,#1A0F0A 65%)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
.card{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:20px;padding:28px;display:flex;flex-direction:column;gap:18px}
.card.feat{border-color:var(--orange);background:linear-gradient(180deg,rgba(232,84,26,.16),rgba(255,255,255,.03) 60%);box-shadow:0 0 60px rgba(232,84,26,.18)}
.card h3{font-weight:400;font-size:1.9rem;letter-spacing:-.04em;text-transform:uppercase;line-height:1}
.card .price{font-size:2.6rem;letter-spacing:-.05em;line-height:1}
.card .price small{font-size:.95rem;color:var(--muted);letter-spacing:0;margin-left:6px}
.delta{align-self:flex-start;font-size:.85rem;padding:6px 12px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
.feat .delta{border-color:var(--orange);color:var(--orange2)}
.card .sub{color:var(--muted);font-size:.95rem;border-top:1px solid var(--line);padding-top:16px}
.card ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.card li{display:flex;gap:10px}
.card li::before{content:"✓";color:var(--orange2)}
.card li.new::before{content:"+"}
.card .btn{margin-top:auto}
.note{color:var(--muted);font-size:.9rem;margin-top:20px;display:block}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;list-style:none;margin:36px 0 0;padding:0;counter-reset:s}
.steps li{counter-increment:s;border:1px solid var(--line);border-radius:16px;padding:20px;background:rgba(255,255,255,.03)}
.steps li::before{content:counter(s);display:block;font-size:2.2rem;letter-spacing:-.05em;color:var(--orange2);margin-bottom:24px;line-height:1}
.steps b{font-weight:500;display:block;margin-bottom:4px}
.steps span{color:var(--muted);font-size:.95rem}
.final{text-align:center;overflow:hidden;padding:110px 0 90px}
.final p{margin:20px auto 0;color:var(--muted);max-width:26em}
.final .cta-row{justify-content:center}
.story{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:start}
.story p{color:var(--muted);margin-top:18px}
.pill{display:grid;gap:14px}
.pill div{border:1px solid var(--line);border-radius:16px;padding:18px 20px;background:rgba(255,255,255,.03)}
.pill b{font-weight:500;display:block}.pill span{color:var(--muted);font-size:.95rem}
.band{border:1px solid var(--orange);border-radius:24px;padding:40px 28px;background:linear-gradient(135deg,rgba(232,84,26,.2),rgba(255,255,255,.02));display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
.band p{color:var(--muted);margin-top:10px;max-width:28em}
.quote{font-size:clamp(1.5rem,4vw,2.6rem);letter-spacing:-.035em;line-height:1.08;max-width:20em}
.quote small{display:block;margin-top:16px;font-size:1rem;letter-spacing:0;color:var(--muted)}
details{border-top:1px solid var(--line);padding:20px 0}details:last-of-type{border-bottom:1px solid var(--line)}
summary{cursor:pointer;font-size:1.2rem;list-style:none;display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--orange2)}details[open] summary::after{content:"–"}
details p{color:var(--muted);margin-top:12px;max-width:36em}
.qwrap{max-width:720px}
.prog{height:4px;background:var(--line);border-radius:4px;margin:18px 0 12px;overflow:hidden}
.prog i{display:block;height:100%;background:linear-gradient(90deg,var(--orange2),var(--orange));transition:width .3s}
.qwrap h2{margin:18px 0 28px}
.opts{display:grid;gap:12px}
.opt{font:inherit;color:var(--ink);text-align:left;padding:18px 22px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.03);cursor:pointer;font-size:1.05rem;transition:border-color .2s,background .2s}
.opt:hover{border-color:var(--orange);background:rgba(232,84,26,.1)}
.linkbtn{font:inherit;background:none;border:0;color:var(--muted);cursor:pointer;padding:0}
.res{max-width:520px;margin:28px 0 0}
.why{border-left:3px solid var(--orange);padding:4px 0 4px 16px;margin-top:20px}
.bd{display:grid;gap:8px}
.bd div{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:.95rem}
.bd .tot{color:var(--ink);border-top:1px solid var(--line);padding-top:10px}
.sm{font-size:.85rem;color:var(--muted);text-align:center}
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 18px calc(12px + env(safe-area-inset-bottom,0px));background:rgba(14,7,5,.92);backdrop-filter:blur(10px);border-top:1px solid var(--line)}
.sticky span{color:var(--muted);font-size:.95rem}.sticky .btn{padding:12px 22px;white-space:nowrap}
footer.site{border-top:1px solid var(--line);padding:28px 0 48px;color:var(--muted);font-size:.9rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
@media (max-width:900px){.cards{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr}.story{grid-template-columns:1fr;gap:28px}}
@media (max-width:600px){.tiles{grid-template-columns:1fr}.tile{min-height:210px}.steps{grid-template-columns:1fr}section{padding:56px 0}}
@media (prefers-reduced-motion:no-preference){.pulse{animation:b 7s ease-in-out infinite alternate}@keyframes b{to{transform:scale(1.15);opacity:.8}}}
</style>
